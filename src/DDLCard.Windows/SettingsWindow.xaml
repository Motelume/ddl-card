<Window x:Class="DDLCard.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置与预设码" Width="640" Height="700" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="设置与预设码" FontSize="27" FontWeight="Bold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,20">
            <StackPanel>
                <TextBlock Text="主题" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="ThemeBox">
                    <ComboBoxItem Content="深夜蓝" Tag="midnight" /><ComboBoxItem Content="柔和灰" Tag="paper" /><ComboBoxItem Content="森林绿" Tag="forest" />
                </ComboBox>
                <TextBlock Text="卡片透明度" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,6" />
                <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                <TextBlock Text="圆角大小" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,6" />
                <Slider x:Name="CornerSlider" Minimum="0" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True" />
                <TextBlock Text="字体缩放" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,6" />
                <Slider x:Name="FontSlider" Minimum="0.85" Maximum="1.25" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                <CheckBox x:Name="TopmostBox" Content="桌面卡片始终置顶" Margin="0,20,0,0" />
                <CheckBox x:Name="EdgeCollapseBox" Content="贴近屏幕左右边缘时自动缩入侧边" Margin="0,12,0,0" />
                <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动" Margin="0,12,0,0" />

                <Border Height="1" Background="#34405E" Margin="0,24" />
                <TextBlock Text="显示预设码" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="预设码只包含主题、透明度、布局偏好和默认提醒，不包含任务。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />
                <TextBox x:Name="PresetCodeBox" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="生成并复制当前预设" Click="CopyPreset_Click" Margin="0,0,8,0" />
                    <Button Content="从剪贴板粘贴" Click="PastePreset_Click" Margin="0,0,8,0" />
                    <Button Content="预览并应用" Click="ApplyPreset_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="保存设置" Click="Save_Click" Background="{StaticResource AccentBrush}" MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>

