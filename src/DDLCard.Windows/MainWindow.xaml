<Window x:Class="DDLCard.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDLCard 任务管理" Height="720" Width="1040"
        MinHeight="560" MinWidth="820" WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DDLCard" FontSize="32" FontWeight="Bold" />
                <TextBlock Text="把最近的截止事项放在你看得见的地方" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="快速添加  Ctrl+Alt+D" Click="QuickAdd_Click" Margin="0,0,10,0" Background="{StaticResource AccentBrush}" />
                <Button Content="完整新建" Click="Add_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,26,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" TextChanged="FilterChanged" ToolTip="搜索标题、分类或备注" />
            <ComboBox x:Name="StateFilter" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="FilterChanged" SelectedIndex="0">
                <ComboBoxItem Content="进行中" Tag="Active" />
                <ComboBoxItem Content="已完成" Tag="Completed" />
                <ComboBoxItem Content="已归档" Tag="Archived" />
                <ComboBoxItem Content="全部" Tag="All" />
            </ComboBox>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="12">
            <Grid>
                <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C2540" CornerRadius="13" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding PriorityBrush}" CornerRadius="3" />
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Background="#2C385A" CornerRadius="7" Margin="10,0,0,0" Padding="7,2">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DueText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,10,0,0" Foreground="{Binding PriorityBrush}" Background="#34405E" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Countdown}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PriorityText, StringFormat=优先级：{0}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button Content="编辑" Tag="{Binding Id}" Click="Edit_Click" Padding="10,6" Margin="0,0,6,0" />
                                        <Button Content="完成" Tag="{Binding Id}" Click="Complete_Click" Padding="10,6" Background="#287B65" Margin="0,0,6,0" Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="更多" Tag="{Binding Id}" Click="More_Click" Padding="10,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="目前没有符合条件的事项" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="先添加一个 DDL，它会同时出现在桌面卡片中。" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="导出备份" Click="Export_Click" Margin="0,0,8,0" />
                <Button Content="导入备份" Click="Import_Click" Margin="0,0,8,0" />
                <Button Content="设置与预设码" Click="Settings_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
        </Grid>
    </Grid>
</Window>
