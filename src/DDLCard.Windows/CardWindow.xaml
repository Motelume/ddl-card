<Window x:Class="DDLCard.Windows.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDLCard" Width="420" Height="560" MinWidth="330" MinHeight="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Border x:Name="CardRoot" Background="#EE151C31" CornerRadius="22" BorderBrush="#33415F" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="DragHeader" MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="即将到期" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="SummaryText" Foreground="#A8B2CC" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Content="置顶" Click="PinButton_Click" Padding="9,5" Margin="0,0,6,0" FontSize="11" />
                    <Button Content="管理" Click="ManageButton_Click" Padding="9,5" FontSize="11" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Height="1" Background="#31405D" Margin="0,15,0,12" />
            <Grid Grid.Row="2">
                <ItemsControl x:Name="TaskItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#A6212B48" CornerRadius="13" Padding="12" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Background="{Binding PriorityBrush}" CornerRadius="3" />
                                    <StackPanel Grid.Column="1" Margin="11,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Countdown}" Foreground="{Binding PriorityBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        <Grid Margin="0,7,0,0">
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="3" Foreground="{Binding PriorityBrush}" Background="#3A4661" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="✓" ToolTip="标记完成" Tag="{Binding Id}" Click="Complete_Click" Padding="8,4" Background="#287B65" Margin="0,0,0,5" />
                                        <Button Content="延期" ToolTip="快捷延期" Tag="{Binding Id}" Click="Postpone_Click" Padding="7,4" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✓" FontSize="34" HorizontalAlignment="Center" Foreground="#63BEA0" />
                    <TextBlock Text="没有进行中的 DDL" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="3" Text="拖动标题移动 · 拖动边角调整大小" Foreground="#71809F" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </Grid>
    </Border>
</Window>

