<Application x:Class="DDLCard.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0B1020" />
        <SolidColorBrush x:Key="PanelBrush" Color="#151C31" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F7FF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#96A1BE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PageBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#263252" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#202A45" />
            <Setter Property="BorderBrush" Value="#354263" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#101526" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="#101526" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Application.Resources>
</Application>
